DEFINITION MODULE Keys ;

(* global keyboard shortcuts grabbed on the root window *)

TYPE
  Action = (NoAction, CycleNext, CyclePrev, CloseWindow, MinimizeWindow,
            MaximizeWindow, FullscreenWindow, DesktopNext, DesktopPrev,
            GotoDesktop, SendNext, SendPrev, OpenLauncher, OpenTerminal,
            OpenFiles, VolumeUp, VolumeDown, VolumeToggleMute) ;

PROCEDURE Grab ;

(* action bound to a key press, with its argument for GotoDesktop *)
PROCEDURE Lookup (code, state: CARDINAL; VAR arg: INTEGER) : Action ;

(* run a volume action *)
PROCEDURE RunVolumeAction (action: Action);

(* is keycode the alt key that ends window cycling *)
PROCEDURE IsCycleModifier (keycode: CARDINAL) : BOOLEAN ;

END Keys.
